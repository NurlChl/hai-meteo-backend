# Server
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://postgres:postgres@db:5432/hai_meteo_db

# JWT - Use a strong secret in production (min 32 characters)
JWT_SECRET=your-super-secret-key-min-32-chars-long
JWT_ACCESS_EXPIRATION_MINUTES=30
JWT_REFRESH_EXPIRATION_DAYS=30

BASE_URL=http://localhost:8000

# Google Cloud Storage
GCS_BUCKET_NAME=your-public-assets-bucket
GCS_PROJECT_ID=your-gcp-project-id
GCS_KEY_FILENAME=./service_account.json
# Optional: used to parse legacy stored public URLs back into object keys
GCS_PUBLIC_BASE_URL=https://storage.googleapis.com/your-public-assets-bucket
GCS_UPLOAD_PATH_PREFIX=media-assets
GCS_SIGNED_URL_EXPIRES_MINUTES=60
